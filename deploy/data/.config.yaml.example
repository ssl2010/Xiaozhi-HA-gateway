server:
  ip: 0.0.0.0
  port: 8000
  http_port: 8003
  websocket: ws://192.168.3.188:8000/xiaozhi/v1/

# Return to idle after ten seconds without detected speech. Do not ask the LLM
# to generate a goodbye sentence when the timeout is reached.
close_connection_no_voice_time: 10
end_prompt:
  enable: false

selected_module:
  VAD: SileroVAD
  ASR: SherpaParaformerASR
  LLM: HybridChat
  VLLM: ChatGLMVLLM
  TTS: EdgeTTS
  Memory: nomem
  Intent: ha_rules

Intent:
  ha_rules:
    type: ha_rules
    functions:
      - ha_control

LLM:
  HybridChat:
    type: hybrid_chat
    temperature: 0.7
    max_tokens: 500

ASR:
  SherpaParaformerASR:
    type: sherpa_onnx_local
    model_dir: models/sherpa-onnx-paraformer-zh-small-2024-03-09
    output_dir: tmp/
    model_type: paraformer

VAD:
  SileroVAD:
    type: silero
    threshold: 0.5
    threshold_low: 0.3
    model_dir: models/snakers4_silero-vad
    # Allow a natural pause between room/device and the requested setting.
    # 350 ms caused commands such as “客厅空调，二十六度” to be split in two.
    min_silence_duration_ms: 1000

TTS:
  EdgeTTS:
    type: edge
    voice: zh-CN-XiaoxiaoNeural
    output_dir: tmp/

delete_audio: true
enable_greeting: false
