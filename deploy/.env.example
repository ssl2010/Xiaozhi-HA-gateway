# Create a Home Assistant long-lived access token and place it in deploy/.env.
# Never commit the real file.
HA_TOKEN=replace_me
# Optional AI chat fallback. Controls continue to work when this is blank.
XIAOZHI_LLM_API_KEY=
XIAOZHI_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
XIAOZHI_LLM_MODEL=glm-4-flash
